{
  "name": "greenhouse",
  "version": "1.0.0",
  "description": "Greenhouse management system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "init-db": "node scripts/init-db.js",
    "init-test-db": "node scripts/init-test-db.js",
    "test": "powershell -ExecutionPolicy Bypass -File ./scripts/run_tests.ps1",
    "test:unit": "powershell -ExecutionPolicy Bypass -File ./scripts/run_tests.ps1 unit",
    "test:integration": "powershell -ExecutionPolicy Bypass -File ./scripts/run_tests.ps1 integration",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File ./scripts/run-e2e-tests.ps1",
    "test:e2e:ci": "dotnet test src/E2ETests/E2ETests.csproj --logger \"trx;LogFileName=e2e-tests.trx\" --results-directory \"test-results\"",
    "test:e2e:filter": "powershell -ExecutionPolicy Bypass -File ./scripts/run-e2e-tests.ps1 -Filter",
    "test:e2e:report": "powershell -ExecutionPolicy Bypass -File ./scripts/run-e2e-tests.ps1 -OpenReport",
    "test:e2e:node": "cd test/e2e && npm test",
    "test:e2e:setup": "cd test/e2e && npm install",
    "test:ci": "docker-compose -f docker-compose.test.yml run --rm test-runner",
    "servers": "powershell -ExecutionPolicy Bypass -File ./scripts/start-servers.ps1",
    "servers:batch": "scripts\\start-servers.bat",
    "test:simple": "dotnet test src/UnitTests/UnitTests.csproj --logger console",
    "test:clean": "dotnet clean && dotnet restore && dotnet test src/UnitTests/UnitTests.csproj",
    "servers:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-servers.ps1",
    "servers:restart": "npm run servers:stop && npm run servers"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}